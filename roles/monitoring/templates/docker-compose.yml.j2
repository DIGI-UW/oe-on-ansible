services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    ports:
      - "{{ monitoring_prometheus_port }}:9090"
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - {{ monitoring_data_dir }}/prometheus:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.enable-lifecycle'
    depends_on:
      - blackbox
      - alertmanager

  blackbox:
    image: {{ monitoring_blackbox_image }}
    container_name: blackbox
    restart: unless-stopped
    ports:
      - "{{ monitoring_blackbox_port }}:9115"
    volumes:
      - ./blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    command:
      - '--config.file=/etc/blackbox_exporter/config.yml'
    cap_add:
      - NET_RAW

  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    container_name: alertmanager
    restart: unless-stopped
    ports:
      - "{{ monitoring_alertmanager_port }}:9093"
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ monitoring_data_dir }}/alertmanager:/alertmanager

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    ports:
      - "{{ monitoring_grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ monitoring_grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_data_dir }}/grafana:/var/lib/grafana
    depends_on:
      - prometheus
